# Copy this file to .env.local and fill in YOUR OWN Supabase project values.
# Supabase Dashboard > Project Settings > API

# Public (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_, never commit, never share.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
# Optional private server URL; defaults to NEXT_PUBLIC_SUPABASE_URL for the setup script.
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Used for invite and password-reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Time zone used when displaying dates
NEXT_PUBLIC_APP_TIME_ZONE=Asia/Manila

# Optional one-time real Supabase account provisioning.
# Set values only in your private .env.local. The setup script reads them server-side.
# The email addresses are formed from these usernames and the domain below.
# A .local development domain does not receive email; the script confirms users through the Admin API.
SETUP_EMAIL_DOMAIN=student.local
# Optional overrides; otherwise the script uses the usernames below.
# SETUP_SUPER_ADMIN_EMAIL=superadmin@student.local
# SETUP_WORKING_SCHOLAR_ADMIN_EMAIL=workingscholar@student.local
# SETUP_FINANCE_ADMIN_EMAIL=financeadmin@student.local
# SETUP_STUDENT_EMAIL=acdstudent@student.local
# Set distinct private passwords of at least 12 characters.
SETUP_SUPER_ADMIN_FULL_NAME=
SETUP_SUPER_ADMIN_PASSWORD=
SETUP_WORKING_SCHOLAR_ADMIN_FULL_NAME=
SETUP_WORKING_SCHOLAR_ADMIN_PASSWORD=
SETUP_FINANCE_ADMIN_FULL_NAME=
SETUP_FINANCE_ADMIN_PASSWORD=
SETUP_STUDENT_FULL_NAME=
SETUP_STUDENT_PASSWORD=
# Set true only when intentionally rotating passwords of already-existing Auth users.
RESET_EXISTING_ACCOUNT_PASSWORDS=false
